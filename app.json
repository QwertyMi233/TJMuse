{
  "expo": {
    "name": "TJMuse",
    "slug": "tjmuse",
    "scheme": "tjmuse",
    "version": "0.5.2",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#FFFFFF",
    "icon": "./assets/icon.png",
    "ios": {
      "supportsTablet": true,
      "buildNumber": "39",
      "bundleIdentifier": "com.tjmuse.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleLocalizations": [
          "zh-Hans",
          "zh-Hant",
          "en",
          "ja",
          "es",
          "fr"
        ]
      }
    },
    "android": {
      "package": "com.tjmuse.app",
      "versionCode": 39,
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "name": "TJMuse",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-system-ui",
      "expo-secure-store",
      "./plugins/with-material-theme.cjs",
      [
        "expo-notifications",
        {
          "color": "#0066B3"
        }
      ],
      [
        "@react-native-community/datetimepicker",
        {}
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "选择一张照片作为你的 TJMuse 头像。",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      "expo-localization",
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "enableBackgroundPlayback": false
        }
      ],
      [
        "expo-widgets",
        {
          "bundleIdentifier": "com.tjmuse.app.widgets",
          "groupIdentifier": "group.com.tjmuse.app",
          "enableAndroid": true,
          "widgets": [
            {
              "name": "DailyAgenda",
              "displayName": "TJMuse · 今日安排",
              "description": "教学周、日期与接下来的课程、To-do 和作业",
              "ios": {
                "supportedFamilies": [
                  "systemLarge"
                ],
                "initialLayout": "src/widgets/AgendaWidget.ios.tsx"
              },
              "android": {
                "targetCellWidth": 4,
                "targetCellHeight": 4,
                "minWidth": 250,
                "minHeight": 250,
                "resizeMode": "both",
                "initialLayout": "src/widgets/AgendaWidget.android.tsx"
              }
            }
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "b2549ef6-6bfb-4ec4-b954-55ba5c643302"
      }
    },
    "owner": "qwertymi"
  }
}
